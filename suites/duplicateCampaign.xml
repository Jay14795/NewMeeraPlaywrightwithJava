<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Runs the auth setup first, then the duplicateCampaign module.
     Use: mvn test -DsuiteXmlFile=suites/duplicateCampaign.xml -->
<suite name="duplicateCampaign suite" verbose="1" preserve-order="true">
    <test name="setup">
        <classes>
            <class name="com.meera.tests.AuthSetupTest"/>
        </classes>
    </test>
    <test name="duplicateCampaign">
        <classes>
            <class name="com.meera.tests.DuplicateCampaignTests"/>
        </classes>
    </test>
</suite>

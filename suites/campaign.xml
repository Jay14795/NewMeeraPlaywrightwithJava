<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Runs the auth setup first, then the campaign module.
     Use: mvn test -DsuiteXmlFile=suites/campaign.xml -->
<suite name="campaign suite" verbose="1" preserve-order="true">
    <test name="setup">
        <classes>
            <class name="com.meera.tests.AuthSetupTest"/>
        </classes>
    </test>
    <test name="campaign">
        <classes>
            <class name="com.meera.tests.CreateCampaignTests"/>
        </classes>
    </test>
</suite>

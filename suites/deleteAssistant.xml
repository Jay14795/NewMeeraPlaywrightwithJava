<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Runs the auth setup first, then the deleteAssistant module.
     Use: mvn test -DsuiteXmlFile=suites/deleteAssistant.xml -->
<suite name="deleteAssistant suite" verbose="1" preserve-order="true">
    <test name="setup">
        <classes>
            <class name="com.meera.tests.AuthSetupTest"/>
        </classes>
    </test>
    <test name="deleteAssistant">
        <classes>
            <class name="com.meera.tests.nlp.assistant.DeleteAssistantTests"/>
        </classes>
    </test>
</suite>

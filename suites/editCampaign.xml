<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Runs the auth setup first, then the editCampaign module.
     Use: mvn test -DsuiteXmlFile=suites/editCampaign.xml -->
<suite name="editCampaign suite" verbose="1" preserve-order="true">
    <test name="setup">
        <classes>
            <class name="com.meera.tests.AuthSetupTest"/>
        </classes>
    </test>
    <test name="editCampaign">
        <classes>
            <class name="com.meera.tests.EditCampaignTests"/>
        </classes>
    </test>
</suite>
